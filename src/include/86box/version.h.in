/*
 * 86Box    A hypervisor and IBM PC system emulator that specializes in
 *          running old operating systems and software designed for IBM
 *          PC systems and compatibles from 1981 through fairly recent
 *          system designs based on the PCI bus.
 *
 *          This file is part of the 86Box distribution.
 *
 *          Definitions for project version, branding, and external links.
 *
 * Authors: Miran Grca, <mgrca8@gmail.com>
 *
 *          Copyright 2020 Miran Grca.
 */
#ifndef EMU_VERSION_H
#define EMU_VERSION_H

#define _LSTR(s) L ## s
#define LSTR(s) _LSTR(s)

/* Version info. */
#define EMU_NAME    "@CMAKE_PROJECT_NAME@"
#define EMU_NAME_W  LSTR(EMU_NAME)

/* MegaPPBox: the emulated ATAPI/SCSI vendor and product strings and the SPD part
   number are guest-visible hardware identity, not branding.  They stay "86Box" so
   the guest sees exactly what stock 86Box presents. */
#define EMU_HW_NAME "86Box"

/* Upstream project this is forked from, shown in the About dialog. */
#define EMU_UPSTREAM_NAME "86Box"
#define EMU_UPSTREAM_SITE "86box.net"

#define MEGAPPBOX_VERSION     "@MEGAPPBOX_VERSION@"
#define MEGAPPBOX_VERSION_MAJ @MEGAPPBOX_VERSION_MAJ@
#define MEGAPPBOX_VERSION_MIN @MEGAPPBOX_VERSION_MIN@

#define EMU_VERSION       "@CMAKE_PROJECT_VERSION@"
#define EMU_VERSION_W     LSTR(EMU_VERSION)
#define EMU_VERSION_MAJ   @CMAKE_PROJECT_VERSION_MAJOR@
#define EMU_VERSION_MIN   @CMAKE_PROJECT_VERSION_MINOR@
#define EMU_VERSION_PATCH @CMAKE_PROJECT_VERSION_PATCH@

#cmakedefine EMU_BUILD     "@EMU_BUILD@"
#define EMU_BUILD_NUM      @EMU_BUILD_NUM@
#cmakedefine EMU_GIT_HASH  "@EMU_GIT_HASH@"

#ifdef BETA_BUILD
# define EMU_VERSION_SUFFIX " Beta"
# define EMU_VERSION_ROMS_SUFFIX "-beta"
#else
# define EMU_VERSION_SUFFIX ""
# define EMU_VERSION_ROMS_SUFFIX ""
#endif
#ifdef EMU_BUILD
# define EMU_BUILD_W      LSTR(EMU_BUILD)
# define EMU_VERSION_FULL EMU_VERSION EMU_VERSION_SUFFIX " [" EMU_BUILD "]"
#else
# define EMU_VERSION_FULL EMU_VERSION EMU_VERSION_SUFFIX
#endif
#define EMU_VERSION_FULL_W LSTR(EMU_VERSION_FULL)
#ifdef EMU_GIT_HASH
# define EMU_GIT_HASH_W LSTR(EMU_GIT_HASH)
#endif

#define COPYRIGHT_YEAR "@EMU_COPYRIGHT_YEAR@"

/* Web URL info. */
#define EMU_SITE       "86box.net"
#define EMU_SITE_W     LSTR(EMU_SITE)
/* MegaPPBox ships its ROM set in the repository and in every build folder;
   documentation lives in the repository's docs/ folder. */
#define EMU_ROMS_URL   "https://github.com/Xeon3D/MegaPPBox/tree/main/roms"
#define EMU_DOCS_URL   "https://github.com/Xeon3D/MegaPPBox/tree/main/docs"
#define EMU_ROMS_URL_W LSTR(EMU_ROMS_URL)
#define EMU_DOCS_URL_W LSTR(EMU_DOCS_URL)

#endif /*EMU_VERSION_H*/
